#!/bin/bash
# Plex to Cache — service control script
# Usage: rc.plex_to_cache {start|stop|restart|condrestart|boot|status}
#
# Persistent user intent:
#   A manual `stop` writes a flag file to the flash drive (survives
#   reboots, since Unraid's root FS is tmpfs). The boot-time `boot`
#   verb and `condrestart` respect that flag, so a stopped service
#   stays stopped until the user explicitly runs `start` again.
#
# Verbs:
#   start        Enable the service and start it now.
#   stop         Stop the service and keep it stopped across reboots.
#   restart      Enable the service and (re)start it.
#   condrestart  Restart only if the service is enabled (used after
#                settings changes / plugin updates).
#   boot         Start only if the service is enabled (used by
#                /etc/rc.d at system boot).
#   status       Report running/enabled state.

PYTHON_SCRIPT="/usr/local/emhttp/plugins/plex_to_cache/scripts/plex_to_cache.py"
PID_FILE="/var/run/plex_to_cache.pid"
LOG_FILE="/var/log/plex_to_cache.log"
DISABLED_FLAG="/boot/config/plugins/plex_to_cache/service_disabled"

# --- state helpers ---------------------------------------------------------

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

is_disabled() {
    [ -f "$DISABLED_FLAG" ]
}

mark_enabled() {
    rm -f "$DISABLED_FLAG"
}

mark_disabled() {
    mkdir -p "$(dirname "$DISABLED_FLAG")"
    touch "$DISABLED_FLAG"
}

# --- start/stop primitives (no flag handling) ------------------------------

do_start() {
    if is_running; then
        echo "Plex to Cache is already running (PID $(cat "$PID_FILE"))."
        return 0
    fi

    # Clean stale PID file from a previous crash/reboot
    rm -f "$PID_FILE"

    # Make sure logfile exists and is writable before the daemon touches it
    touch "$LOG_FILE" 2>/dev/null
    chmod 666 "$LOG_FILE" 2>/dev/null

    echo "Starting Plex to Cache service..."
    nohup python3 "$PYTHON_SCRIPT" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    # Give the daemon a moment to acquire its flock — if another instance
    # already has the lock, our process exits fast and we should reflect that.
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PID_FILE"
        echo "Service failed to start — check $LOG_FILE"
        return 1
    fi
    echo "Service started (PID $pid)."
}

do_stop() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "Stopping Plex to Cache service (PID $pid)..."
            kill "$pid" 2>/dev/null
            # Wait up to 5 s for graceful shutdown, then SIGKILL
            for _ in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 1
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null
            fi
        fi
        rm -f "$PID_FILE"
    fi
    # Paranoia: kill anything that looks like our daemon
    pkill -f "$PYTHON_SCRIPT" 2>/dev/null
    echo "Service stopped."
}

# --- user-facing verbs ------------------------------------------------------

start() {
    mark_enabled
    do_start
}

stop() {
    mark_disabled
    do_stop
    echo "Autostart disabled — the service stays stopped until you start it again."
}

restart() {
    mark_enabled
    do_stop
    sleep 1
    do_start
}

condrestart() {
    if is_disabled; then
        echo "Service is disabled by user — not restarting."
        return 0
    fi
    do_stop
    sleep 1
    do_start
}

boot() {
    if is_disabled; then
        echo "Service is disabled by user — skipping autostart."
        return 0
    fi
    do_start
}

status() {
    if is_running; then
        echo "Plex to Cache is running (PID $(cat "$PID_FILE"))."
        exit 0
    fi
    if is_disabled; then
        echo "Plex to Cache is stopped (autostart disabled by user)."
    else
        echo "Plex to Cache is stopped."
    fi
    exit 3
}

case "$1" in
    start)       start ;;
    stop)        stop ;;
    restart)     restart ;;
    condrestart) condrestart ;;
    boot)        boot ;;
    status)      status ;;
    *)
        echo "Usage: $0 {start|stop|restart|condrestart|boot|status}"
        exit 1
        ;;
esac
